{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m agentflow.cli:*)",
      "Bash(ruff:*)",
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)"
    ]
  },
  "env": {
    "AGENTFLOW_GUARDRAILS_ENABLED": "true",
    "AGENTFLOW_GUARDRAILS_FAIL_CLOSED": "true",
    "AGENTFLOW_PII_REDACTION": "true"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m agentflow.cli guard --stage input --json",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -m agentflow.cli guard --stage input --json",
            "timeout": 10
          }
        ]
      }
    ]
  }
}