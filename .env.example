# AgentFlow configuration
# Copy to `.env` and fill in. With no key set AgentFlow runs in OFFLINE mode
# against a deterministic scripted model, so the whole runtime is demo-able
# and the test-suite runs with zero network access.

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5

# Force the offline scripted client even when a key is present. Useful for
# deterministic demos, CI and reproducing a bug report.
AGENTFLOW_FORCE_OFFLINE=false

# Retrieval. `hashing` is deterministic and downloads nothing; `sentence` and
# `voyage` opt into real embeddings (and, for voyage, need VOYAGE_API_KEY).
AGENTFLOW_EMBEDDER=hashing

# Agent fan-out
AGENTFLOW_MAX_PARALLEL_AGENTS=4
AGENTFLOW_AGENT_TIMEOUT_S=30

# MCP servers connected by `agentflow serve --with-mcp`
AGENTFLOW_MCP_MANIFEST=mcp_servers/manifest.json

# Routing
AGENTFLOW_SMALL_MODEL=claude-haiku-4-5
AGENTFLOW_MID_MODEL=claude-sonnet-4-5
AGENTFLOW_LARGE_MODEL=claude-opus-4-5
AGENTFLOW_FALLBACK_MODEL=claude-haiku-4-5

# Token budgets
AGENTFLOW_REQUEST_TOKEN_BUDGET=60000
AGENTFLOW_SESSION_TOKEN_BUDGET=180000
AGENTFLOW_CACHE_MIN_TOKENS=1024

# Guardrails
AGENTFLOW_GUARDRAILS_ENABLED=true
AGENTFLOW_GUARDRAILS_FAIL_CLOSED=true
AGENTFLOW_PII_REDACTION=true

# Guardrails blocklist: pipe-separated case-insensitive substrings
# Secret requests (passwords / api keys / private keys) are already handled by
# dedicated detectors, so keep this to topics genuinely out of scope.
AGENTFLOW_BLOCKED_TOPICS=medical diagnosis|investment advice|weapon synthesis

# Telemetry
AGENTFLOW_TELEMETRY=true